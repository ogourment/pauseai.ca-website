<!DOCTYPE html>
<%!-- The site has one palette. data-theme is pinned so daisyUI component
     colours cannot diverge from it; remove the pin when a dark palette exists. --%>
<html lang={assigns[:locale] || "en"} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Non-production deployments are reachable but must never be indexed. --%>
    <% seo = PauseAiCaWeb.SEO.for_conn(@conn) %>
    <PhoenixAppShell.SEO.head {seo} />
    <.live_title
      default={gettext("PauseAI Canada")}
      suffix={if seo.canonical, do: "", else: " · " <> gettext("PauseAI Canada")}
      phx-no-format
    >{if seo.canonical, do: seo.title, else: assigns[:page_title]}</.live_title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/images/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href={PauseAiCa.Environment.favicon_path()} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" sizes="180x180" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <%= if PauseAiCa.Assistant.eligible?(@conn.assigns[:current_scope]) do %>
      {live_render(@conn, PauseAiCaWeb.AssistantLive,
        id: "persistent-assistant",
        sticky: true,
        session: %{
          "user_token" => Plug.Conn.get_session(@conn, :user_token),
          "site_locale" => @conn.assigns[:locale] || "en"
        }
      )}
    <% end %>
  </body>
</html>

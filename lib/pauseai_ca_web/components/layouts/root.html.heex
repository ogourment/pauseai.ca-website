<!DOCTYPE html>
<%!-- The site has one palette. data-theme is pinned so daisyUI component
     colours cannot diverge from it; remove the pin when a dark palette exists. --%>
<html lang={assigns[:locale] || "en"} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Non-production deployments are reachable but must never be indexed. --%>
    <meta :if={PauseAiCa.Environment.badged?()} name="robots" content="noindex, nofollow" />
    <.live_title
      default={gettext("PauseAI Canada")}
      suffix={" · " <> gettext("PauseAI Canada")}
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <link rel="icon" href={PauseAiCa.Environment.favicon_path()} type="image/svg+xml" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <%= if PauseAiCa.Assistant.eligible?(@conn.assigns[:current_scope]) do %>
      {live_render(@conn, PauseAiCaWeb.AssistantLive,
        id: "persistent-assistant",
        sticky: true,
        session: %{"user_token" => Plug.Conn.get_session(@conn, :user_token)}
      )}
    <% end %>
  </body>
</html>

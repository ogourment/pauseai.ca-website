<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  translated_path={if(@locale == "fr", do: ~p"/en/about", else: ~p"/fr/a-propos")}
>
  <article id="about" class="mx-auto max-w-4xl px-5 py-16 sm:py-24">
    <p class="eyebrow">PauseAI Canada</p>
    <h1 class="mt-3 font-heading text-5xl text-stone-950">
      {gettext("Who we are")}
    </h1>
    <p class="mt-7 text-xl leading-9 text-stone-700">
      {gettext(
        "PauseAI Canada is a developing Canadian group raising public awareness of risks from advanced AI systems and advocating for national and international safeguards."
      )}
    </p>
    <div class="mt-10 space-y-8 leading-8 text-stone-600">
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Our role")}
        </h2><p class="mt-3">
          {gettext(
            "We adapt the case and opportunities for action to the Canadian context in both official languages. We help people form a view, contact representatives, and organize."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Our relationships")}
        </h2><p class="mt-3">
          {gettext("We collaborate with")}
          <a
            class="font-semibold underline decoration-brand underline-offset-4"
            href="https://pauseai.info/"
          >PauseAI Global</a>,
          <a
            class="font-semibold underline decoration-brand underline-offset-4"
            href="https://pauseia.fr/fr"
          >Pause IA</a>
          {gettext("and")}
          <a
            class="font-semibold underline decoration-brand underline-offset-4"
            href="https://www.pauseai-us.org/"
          >PauseAI US</a>.
        </p>
      </section>
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Contact us")}
        </h2><p class="mt-3">
          {gettext("Want to participate? Join PauseAI Canada.")}
        </p><.link
          class="mt-4 inline-flex rounded-full bg-brand px-5 py-3 font-semibold text-stone-950"
          navigate={
            if(@locale == "fr", do: ~p"/fr/comprendre#updates", else: ~p"/en/learn#updates")
          }
        >{gettext("Join PauseAI Canada")}</.link>
      </section>
    </div>
  </article>
</Layouts.app>

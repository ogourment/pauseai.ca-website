<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  translated_path={if(@locale == "fr", do: ~p"/en/about", else: ~p"/fr/a-propos")}
>
  <article id="about" class="mx-auto max-w-4xl px-5 py-16 sm:py-24">
    <p class="eyebrow">{gettext("PauseAI Canada")}</p>
    <h1 class="mt-3 font-heading text-5xl text-stone-950">
      {gettext("Who we are")}
    </h1>
    <p class="mt-7 text-xl leading-9 text-stone-700">
      {gettext(
        "PauseAI Canada is a citizens’ group calling for an international pause in the development of advanced AI until its safety can be established."
      )}
    </p>
    <div class="mt-10 space-y-8 leading-8 text-stone-600">
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Our role")}
        </h2><p class="mt-3">
          {gettext(
            "We organize meetings and demonstrations, share information in French and English, and help people contact their elected representatives."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Our recent action")}
        </h2>
        <p class="mt-3">
          {gettext(
            "Around 40 people joined our September 26 Montréal demonstration for a coordinated pause in advanced AI development."
          )}
        </p>
        <.link
          id="about-protest-link"
          class="mt-3 inline-block font-semibold underline decoration-brand decoration-2 underline-offset-4"
          navigate={
            if @locale == "fr",
              do: ~p"/fr/manifestation-montreal-2026-09-26",
              else: ~p"/en/montreal-protest-2026-09-26"
          }
        >{gettext("See the Montréal protest and photos")}</.link>
      </section>
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Part of an international movement")}
        </h2><p class="mt-3">
          {gettext("We collaborate with")}
          <a
            class="font-semibold underline decoration-brand underline-offset-4"
            href="https://pauseai.info/"
          >{gettext("PauseAI Global")}</a>
        </p>
      </section>
      <section>
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Contact us")}
        </h2><p class="mt-3">
          {gettext("Want to participate? Join PauseAI Canada.")}
        </p><.link
          class="mt-4 inline-flex rounded-full bg-brand px-5 py-3 font-semibold text-stone-950"
          navigate={
            if(@locale == "fr", do: ~p"/fr/comprendre#updates", else: ~p"/en/learn#updates")
          }
        >{gettext("Join Us")}</.link>
      </section>
      <section id="technical" class="scroll-mt-64 sm:scroll-mt-40 border-t border-stone-200 pt-8">
        <h2 class="font-heading text-3xl text-stone-950">
          {gettext("Technical details and contributions")}
        </h2>
        <p class="mt-3">
          {gettext(
            "The website application runs on an OVHcloud server in Beauharnois, Québec, Canada, where its application database is also hosted."
          )}
        </p>
        <p class="mt-3">
          {gettext(
            "The site uses Elixir, Phoenix LiveView and PostgreSQL. Its source code is public on GitHub."
          )}
        </p>
        <p class="mt-3">
          {gettext(
            "You can report a problem, suggest clearer wording, improve translations or contribute code."
          )}
        </p>
        <ul class="mt-3 list-disc space-y-2 pl-5">
          <li>
            <a class="underline" href="https://github.com/ogourment/pauseai.ca-website">{gettext(
              "Source code on GitHub"
            )}</a>
          </li>
          <li>
            <a
              class="underline"
              href="https://github.com/ogourment/pauseai.ca-website/blob/main/CONTRIBUTING.md"
            >{gettext("How to contribute")}</a>
          </li>
          <li>
            <a class="underline" href="https://github.com/ogourment/pauseai.ca-website/issues">{gettext(
              "Report a problem or suggest a change"
            )}</a>
          </li>
        </ul>
        <p class="mt-3">
          {gettext("Email delivery uses Brevo; optional analytics use Google Analytics.")}
          <.link
            class="underline"
            href={
              if(@locale == "fr",
                do: ~p"/fr/confidentialite#hosting",
                else: ~p"/en/privacy#hosting"
              )
            }
          >{gettext("Read our privacy policy.")}</.link>
        </p>
      </section>
    </div>
  </article>
</Layouts.app>

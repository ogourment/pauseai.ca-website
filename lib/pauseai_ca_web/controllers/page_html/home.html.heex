<Layouts.app flash={@flash} current_scope={@current_scope} locale={@locale}>
  <section class="relative overflow-hidden border-b border-stone-200">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_15%,rgba(239,91,53,0.18),transparent_32%),linear-gradient(180deg,#f8f5ed_0%,#f3efe4_100%)]">
    </div>
    <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
      <h1 class="max-w-4xl font-serif text-5xl leading-[1.02] tracking-tight text-stone-950 sm:text-7xl">
        {gettext("How far should we let AI advance?")}
      </h1>
      <p id="latest-safety-context" class="mt-6 max-w-2xl text-lg leading-8 text-stone-700">
        {gettext(
          "What risks could advanced AI pose, and what can Canada do about them? Explore the research, proposals for a pause, and ways to get involved."
        )}
        <a
          href={
            if(@locale == "fr",
              do: ~p"/fr/signal-d-alarme#developments",
              else: ~p"/en/warning-shot#developments"
            )
          }
          class="font-semibold underline decoration-brand decoration-2 underline-offset-4"
        >{gettext("Latest developments")}</a>
      </p>
      <a
        href="#questions"
        class="mt-9 inline-flex rounded-full bg-stone-900 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-stone-700"
      >
        {gettext("Begin · 2 minutes")}
      </a>
    </div>
  </section>

  <PauseAiCaWeb.LearningJourney.journey locale={@locale} current_scope={@current_scope} quiz />

  <section id="reflection" class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
      <div>
        <p class="eyebrow">
          {gettext("Your starting point")}
        </p>
        <h2 class="mt-3 font-serif text-4xl leading-tight text-stone-950">
          {gettext("Where do you stand today?")}
        </h2>
      </div>

      <div
        id="belief-check"
        data-locale={@locale}
        data-account-answers={
          if @current_scope, do: Jason.encode!(@current_scope.user.belief_answers), else: ""
        }
        class="space-y-6"
      >
        <.belief_question
          id="risk"
          number="01"
          question={gettext("AI poses a genuine existential risk.")}
          locale={@locale}
        />
        <.belief_question
          id="pause"
          number="02"
          question={gettext("A pause or treaty could materially reduce that risk.")}
          locale={@locale}
        />
        <.belief_question
          id="coordination"
          number="03"
          question={
            gettext(
              "International coordination is politically achievable—countries can agree, comply, and enforce it."
            )
          }
          locale={@locale}
        />
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <button
            id="show-path"
            type="button"
            class="rounded-full bg-brand px-6 py-3 font-semibold text-stone-950 hover:bg-brand-strong"
          >
            {gettext("Show my suggested path")}
          </button>
          <button
            id="reset-beliefs"
            type="button"
            class="text-sm font-semibold text-stone-500 underline-offset-4 hover:text-stone-900 hover:underline"
          >
            {gettext("Clear my answers")}
          </button>
          <p id="local-status" class="text-sm text-stone-500" aria-live="polite"></p>
        </div>
        <div
          id="save-progress-invitation"
          class="hidden rounded-3xl border border-brand/40 bg-brand-wash p-6"
          aria-live="polite"
        >
          <p class="font-serif text-2xl text-stone-950">
            {gettext("Save your answers and continue your path on another device.")}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-4">
            <.link
              id="save-question-progress"
              href={~p"/users/register?#{%{from: "questions", locale: @locale}}"}
              class="rounded-full bg-stone-900 px-5 py-3 font-semibold text-white hover:bg-stone-700"
            >
              {gettext("Create an account to save your progress")}
            </.link>
            <.link
              href={if(@locale == "fr", do: ~p"/fr/confidentialite", else: ~p"/en/privacy")}
              class="text-sm font-semibold text-stone-600 underline underline-offset-4"
            >
              {gettext("Privacy policy")}
            </.link>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="reading-path" class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="max-w-2xl">
        <h2 class="font-serif text-4xl text-stone-950">
          {gettext("Start where you have questions.")}
        </h2>
        <p id="path-explanation" class="mt-5 text-lg leading-8 text-stone-600"></p>
      </div>

      <div id="resource-grid" class="mt-10 grid gap-5 md:grid-cols-2">
        <.resource_card
          id="resource-risk"
          stage={gettext("Understand the risk")}
          title={gettext("Why do researchers discuss existential risk?")}
          body={
            gettext(
              "How could people lose control of an AI system? Read an introduction to the risks researchers are studying."
            )
          }
          href={gettext("https://pauseai.info/xrisk")}
          source={if(@locale == "fr", do: "Yoshua Bengio", else: "PauseAI")}
          cta={gettext("Read the source overview")}
          bookmark="risk"
          locale={@locale}
          current_scope={@current_scope}
        />
        <.resource_card
          id="resource-pause"
          stage={gettext("Evaluate responses")}
          title={gettext("What would a pause actually mean?")}
          body={
            gettext(
              "What would pause, what would continue, and how a pause differs from a blanket ban on AI."
            )
          }
          href={gettext("https://pauseai.info/proposal")}
          source={gettext("PauseAI")}
          cta={gettext("Examine the proposal")}
          bookmark="pause"
          locale={@locale}
          current_scope={@current_scope}
        />
        <.resource_card
          id="resource-coordination"
          stage={gettext("Test coordination")}
          title={gettext("Could a global treaty be verified?")}
          body={
            gettext(
              "How inspections of advanced chips and data centres could help countries verify an agreement."
            )
          }
          href={gettext("https://pauseai.info/feasibility")}
          source={gettext("PauseAI (in English)")}
          cta={gettext("Explore the mechanisms")}
          bookmark="coordination"
          locale={@locale}
          current_scope={@current_scope}
        />
        <.resource_card
          id="resource-agency"
          stage={gettext("Move toward action")}
          title={gettext("Why public support matters")}
          body={
            gettext(
              "Letters, meetings and public events can show elected representatives that people want action on AI risks."
            )
          }
          href={if(@locale == "fr", do: ~p"/fr/strategie", else: ~p"/en/strategy")}
          source={gettext("PauseAI Canada")}
          cta={gettext("Read the summary")}
          bookmark="agency"
          locale={@locale}
          current_scope={@current_scope}
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="rounded-[2rem] bg-[#18352f] p-8 text-white sm:p-12">
      <h2 class="font-serif text-4xl">{gettext("Stay informed")}</h2>
      <a
        href={if(@locale == "fr", do: "/fr/comprendre#updates", else: "/en/learn#updates")}
        class="mt-6 inline-block rounded-full bg-white px-6 py-3 font-semibold text-stone-900"
      >{gettext("Subscribe")}</a>
      <a
        href={~p"/users/register?#{%{from: "home_footer", locale: @locale}}"}
        class="ml-6 inline-block font-semibold text-white underline"
      >{gettext("Create an account")}</a>
    </div>
  </section>
</Layouts.app>

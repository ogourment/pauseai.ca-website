<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  translated_path={if(@locale == "fr", do: ~p"/en/privacy", else: ~p"/fr/confidentialite")}
>
  <article id="privacy" class="mx-auto max-w-3xl px-5 py-16 sm:py-24">
    <h1 class="font-serif text-5xl text-stone-950">
      {gettext("Privacy policy")}
    </h1>
    <div class="mt-8 space-y-7 text-lg leading-8 text-stone-700">
      <p>
        {gettext(
          "PauseAI Canada collects only the information needed to provide the features you choose to use."
        )}
      </p>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your account")}
        </h2>
        <p class="mt-2">
          {gettext(
            "Your email secures your account, retrieves saved items, and—with your consent—delivers relevant updates. We do not sell personal information."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your answers and actions")}
        </h2>
        <p class="mt-2">
          {gettext(
            "Answers remain in your browser until you choose to save them to your account. Actions saved in your account are private; we may use aggregate totals to understand movement progress."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your profile")}
        </h2>
        <p class="mt-2">
          {gettext(
            "If you choose to complete your profile, we store your postal code, local-update preference, public information about your MP, and resources you save. You can change or remove these items in My profile."
          )}
        </p>
      </section>
      <p>
        {gettext("Questions: info@pauseai.ca")}
      </p>
    </div>
  </article>
</Layouts.app>

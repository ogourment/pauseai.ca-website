<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  translated_path={if(@locale == "fr", do: ~p"/en/privacy", else: ~p"/fr/confidentialite")}
>
  <article id="privacy" class="mx-auto max-w-3xl px-5 py-16 sm:py-24">
    <h1 class="font-serif text-5xl text-stone-950">
      {gettext("Privacy policy")}
    </h1>
    <div class="mt-8 space-y-7 text-lg leading-8 text-stone-700">
      <p>
        {gettext(
          "This policy explains how PauseAI Canada uses information from site visits, accounts, subscriptions, recorded activities and donation pledges."
        )}
      </p>
      <section id="hosting">
        <h2 class="font-heading text-2xl text-stone-950">{gettext("Hosting")}</h2>
        <p class="mt-2">
          {gettext(
            "The website application runs on an OVHcloud server in Beauharnois, Québec, Canada, where its application database is also hosted."
          )}
        </p>
        <p class="mt-2">
          {gettext(
            "We also use external services for email (Brevo) and optional analytics (Google Analytics). The public source code is published on GitHub. The Canadian hosting statement applies to the website application and its database."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your account")}
        </h2>
        <p class="mt-2">
          {gettext(
            "Your email secures your account and retrieves saved items. We do not sell personal information."
          )}
        </p>
      </section>
      <section id="newsletter-privacy">
        <h2 class="font-heading text-2xl text-stone-950">{gettext("Newsletter")}</h2>
        <p class="mt-2">
          {gettext(
            "When you subscribe, we store your email, optional name and postal area (the first three characters of your Canadian postal code), and the language of the signup page in our Canadian database. We send a confirmation email. Subscribing does not create an account. Brevo delivers email; our website keeps the subscription and withdrawal records. Every newsletter includes an unsubscribe link."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your answers and actions")}
        </h2>
        <p class="mt-2">
          {gettext(
            "Your answers remain in your browser for your own suggested path. We also record them with a random browser identifier so anonymous answers, Learn visits, opened resources, and bookmarks can contribute to aggregate learning metrics. We do not attach an IP address or user agent. If you sign in later, that browser's learning signals are associated with your account to avoid counting you twice. Actions saved in your account remain private."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your profile")}
        </h2>
        <p class="mt-2">
          {gettext(
            "If you choose to complete your profile, we store your city, postal code, local-update preference, public information about your MP, and resources you save. You can change or remove these items in My profile."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">{gettext("Donation pledges")}</h2>
        <p class="mt-2">
          {gettext(
            "When you make a pledge, we store your name, email, contribution frequency, optional amount and notes, preferred language, and permission to contact you about the pledge. Authorized administrators use these details for follow-up. No payment information is collected, and making a pledge does not create an account or subscribe you to updates. Contact info@pauseai.ca to correct or remove your pledge."
          )}
        </p>
      </section>
      <p>
        {gettext("Questions: info@pauseai.ca")}
      </p>
    </div>
  </article>
</Layouts.app>

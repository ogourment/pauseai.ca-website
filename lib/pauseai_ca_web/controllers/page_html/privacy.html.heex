<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  translated_path={if(@locale == "fr", do: ~p"/en/privacy", else: ~p"/fr/confidentialite")}
>
  <article id="privacy" class="mx-auto max-w-3xl px-5 py-16 sm:py-24">
    <h1 class="font-serif text-5xl text-stone-950">
      {gettext("Privacy policy")}
    </h1>
    <div class="mt-8 space-y-7 text-lg leading-8 text-stone-700">
      <p>
        {gettext(
          "PauseAI Canada collects only the information needed to provide the features you choose to use."
        )}
      </p>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your account")}
        </h2>
        <p class="mt-2">
          {gettext(
            "Your email secures your account and retrieves saved items. If you subscribe for updates, Brevo holds your email and any city or postal code you optionally provide. When you later create an account with the same email, we copy that location into your profile. We do not sell personal information."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your answers and actions")}
        </h2>
        <p class="mt-2">
          {gettext(
            "Your answers remain in your browser for your own suggested path. We also record them with a random browser identifier so anonymous answers, Learn visits, opened resources, and bookmarks can contribute to aggregate learning metrics. We do not attach an IP address or user agent. If you sign in later, that browser's learning signals are associated with your account to avoid counting you twice. Actions saved in your account remain private."
          )}
        </p>
      </section>
      <section>
        <h2 class="font-heading text-2xl text-stone-950">
          {gettext("Your profile")}
        </h2>
        <p class="mt-2">
          {gettext(
            "If you choose to complete your profile, we store your city, postal code, local-update preference, public information about your MP, and resources you save. You can change or remove these items in My profile."
          )}
        </p>
      </section>
      <p>
        {gettext("Questions: info@pauseai.ca")}
      </p>
    </div>
  </article>
</Layouts.app>

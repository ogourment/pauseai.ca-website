digraph organizer_tasks {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc="t";
  label=< <B>Organizer tasks and Activity</B><BR/><FONT POINT-SIZE="12">Local tables show every column. Amber dashed arrows cross a domain boundary.</FONT> >;

  subgraph cluster_local {
    label="Organizer tasks and Activity";
    color="#94a3b8";
    penwidth=1.5;
    style="rounded";
  "organizer_tasks" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.organizer_tasks</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">requester_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">accountable_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">assignee_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">backup_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">due_date</TD><TD ALIGN="LEFT">date NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  "organizer_task_dependencies" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.organizer_task_dependencies</B></TD></TR>
      <TR><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">task_id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">prerequisite_id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR>
    </TABLE>
  >];

  "organizer_task_events" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.organizer_task_events</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">command_id</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">bytea NOT NULL</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  }

  subgraph cluster_external {
    label="External-domain references — other relationships are intentionally omitted";
    color="#cbd5e1";
    penwidth=1;
    style="rounded";
  "users" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: users</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  "volunteer_groups" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: volunteer_groups</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  }

  "organizer_task_dependencies" -> "organizer_tasks" [label="group_id -> group_id", color="#64748b"];
  "organizer_task_dependencies" -> "organizer_tasks" [label="group_id -> group_id", color="#64748b"];
  "organizer_task_dependencies" -> "organizer_tasks" [label="prerequisite_id -> id", color="#64748b"];
  "organizer_task_dependencies" -> "organizer_tasks" [label="task_id -> id", color="#64748b"];
  "organizer_task_events" -> "users" [label="actor_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "organizer_task_events" -> "organizer_tasks" [label="group_id -> group_id", color="#64748b"];
  "organizer_task_events" -> "organizer_tasks" [label="task_id -> id", color="#64748b"];
  "organizer_tasks" -> "users" [label="accountable_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "organizer_tasks" -> "users" [label="assignee_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "organizer_tasks" -> "users" [label="backup_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "organizer_tasks" -> "volunteer_groups" [label="group_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "organizer_tasks" -> "users" [label="requester_id -> id", color="#d97706", style="dashed", penwidth=1.5];
}

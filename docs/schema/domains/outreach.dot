digraph outreach {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc="t";
  label=< <B>Outreach</B><BR/><FONT POINT-SIZE="12">Local tables show every column. Amber dashed arrows cross a domain boundary.</FONT> >;

  subgraph cluster_local {
    label="Outreach";
    color="#94a3b8";
    penwidth=1.5;
    style="rounded";
  "pending_letters" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.pending_letters</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">token</TD><TD ALIGN="LEFT">bytea NOT NULL</TD></TR><TR><TD ALIGN="LEFT">sender_name</TD><TD ALIGN="LEFT">character varying NULL</TD></TR><TR><TD ALIGN="LEFT">sender_email</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">recipients</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">subject</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">body</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">locale</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">send_intent_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR>
    </TABLE>
  >];

  "campaign_send_intents" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.campaign_send_intents</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">bytea NOT NULL</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">action_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">error_code</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">template_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">template_revision</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD ALIGN="LEFT">attempted_at</TD><TD ALIGN="LEFT">timestamp without time zone NULL</TD></TR><TR><TD ALIGN="LEFT">accepted_at</TD><TD ALIGN="LEFT">timestamp without time zone NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  "mp_templates" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.mp_templates</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">published_revision</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">timestamp without time zone NULL</TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  "mp_template_revisions" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.mp_template_revisions</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">template_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">editor_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">author_permission</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  }

  subgraph cluster_external {
    label="External-domain references — other relationships are intentionally omitted";
    color="#cbd5e1";
    penwidth=1;
    style="rounded";
  "actions" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: actions</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  "users" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: users</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  }

  "campaign_send_intents" -> "actions" [label="action_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "campaign_send_intents" -> "users" [label="actor_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "mp_template_revisions" -> "mp_templates" [label="template_id -> id", color="#64748b"];
  "pending_letters" -> "campaign_send_intents" [label="send_intent_id -> id", color="#64748b"];
}

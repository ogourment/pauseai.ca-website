digraph welcome {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc="t";
  label=< <B>Welcome cohorts</B><BR/><FONT POINT-SIZE="12">Local tables show every column. Amber dashed arrows cross a domain boundary.</FONT> >;

  subgraph cluster_local {
    label="Welcome cohorts";
    color="#94a3b8";
    penwidth=1.5;
    style="rounded";
  "welcome_sessions" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.welcome_sessions</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">host_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">creator_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">language</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">timezone</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">meeting_url</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  "welcome_participants" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.welcome_participants</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">draft_batch_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">invitation_state</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">invited_at</TD><TD ALIGN="LEFT">timestamp without time zone NULL</TD></TR><TR><TD ALIGN="LEFT">rsvp</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">responded_at</TD><TD ALIGN="LEFT">timestamp without time zone NULL</TD></TR><TR><TD ALIGN="LEFT">attendance</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">attendance_by_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">follow_up</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  "welcome_events" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.welcome_events</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">session_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">participant_id</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">command_id</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">fingerprint</TD><TD ALIGN="LEFT">bytea NOT NULL</TD></TR><TR><TD ALIGN="LEFT">result_kind</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">result_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  }

  subgraph cluster_external {
    label="External-domain references — other relationships are intentionally omitted";
    color="#cbd5e1";
    penwidth=1;
    style="rounded";
  "mail_batches" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: mail_batches</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  "users" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: users</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  "volunteer_groups" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: volunteer_groups</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  }

  "welcome_events" -> "users" [label="actor_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_events" -> "volunteer_groups" [label="group_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_events" -> "welcome_participants" [label="participant_id -> id", color="#64748b"];
  "welcome_events" -> "welcome_sessions" [label="session_id -> id", color="#64748b"];
  "welcome_participants" -> "users" [label="attendance_by_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_participants" -> "mail_batches" [label="draft_batch_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_participants" -> "welcome_sessions" [label="group_id -> group_id", color="#64748b"];
  "welcome_participants" -> "welcome_sessions" [label="session_id -> id", color="#64748b"];
  "welcome_participants" -> "users" [label="user_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_sessions" -> "users" [label="creator_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_sessions" -> "volunteer_groups" [label="group_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "welcome_sessions" -> "users" [label="host_id -> id", color="#d97706", style="dashed", penwidth=1.5];
}

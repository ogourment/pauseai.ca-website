digraph donations {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.6, ranksep=0.9, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
  labelloc="t";
  label=< <B>Donations and authored page content</B><BR/><FONT POINT-SIZE="12">Local tables show every column. Amber dashed arrows cross a domain boundary.</FONT> >;

  subgraph cluster_local {
    label="Donations and authored page content";
    color="#94a3b8";
    penwidth=1.5;
    style="rounded";
  "donation_pledges" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.donation_pledges</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">amount_cad</TD><TD ALIGN="LEFT">numeric NULL</TD></TR><TR><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">locale</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR><TR><TD ALIGN="LEFT">consented_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">frequency</TD><TD ALIGN="LEFT">character varying NOT NULL</TD></TR>
    </TABLE>
  >];

  "donation_pages" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.donation_pages</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">published_payload</TD><TD ALIGN="LEFT">jsonb NULL</TD></TR><TR><TD ALIGN="LEFT">published_revision</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD ALIGN="LEFT">published_at</TD><TD ALIGN="LEFT">timestamp without time zone NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_by</TD><TD ALIGN="LEFT">uuid NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  "donation_page_revisions" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#2563eb">
      <TR><TD BGCOLOR="#dbeafe" COLSPAN="2"><B>public.donation_page_revisions</B></TD></TR>
      <TR><TD ALIGN="LEFT">id PK</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">page_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer NOT NULL</TD></TR><TR><TD ALIGN="LEFT">editor_id</TD><TD ALIGN="LEFT">uuid NOT NULL</TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT">jsonb NOT NULL</TD></TR><TR><TD ALIGN="LEFT">published_payload</TD><TD ALIGN="LEFT">jsonb NULL</TD></TR><TR><TD ALIGN="LEFT">published_revision</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD ALIGN="LEFT">inserted_at</TD><TD ALIGN="LEFT">timestamp without time zone NOT NULL</TD></TR>
    </TABLE>
  >];

  }

  subgraph cluster_external {
    label="External-domain references — other relationships are intentionally omitted";
    color="#cbd5e1";
    penwidth=1;
    style="rounded";
  "users" [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#fef3c7"><B>external: users</B></TD></TR>
      <TR><TD><FONT POINT-SIZE="10">other fields and relationships omitted</FONT></TD></TR>
    </TABLE>
  >];

  }

  "donation_page_revisions" -> "users" [label="editor_id -> id", color="#d97706", style="dashed", penwidth=1.5];
  "donation_page_revisions" -> "donation_pages" [label="page_id -> id", color="#64748b"];
  "donation_pages" -> "users" [label="updated_by -> id", color="#d97706", style="dashed", penwidth=1.5];
}

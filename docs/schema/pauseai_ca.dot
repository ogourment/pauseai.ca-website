digraph Schema {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    overlap=false,
    splines=polyline,
    nodesep=0.65,
    ranksep=1.0,
    pad=0.35
  ];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10, color="#64748b", arrowsize=0.75, penwidth=1.2];

  "public.acceptance_harness_comments" [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#e2e8f0" COLSPAN="2"><FONT POINT-SIZE="12"><B>public.acceptance_harness_comments</B></FONT></TD></TR>
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id PK</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">bigint NOT NULL</FONT></TD></TR>
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">run_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">text NOT NULL</FONT></TD></TR>
  <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">scenario_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">text</FONT></TD></TR>
